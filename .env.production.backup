# Cloudflare Internet Deployment Configuration
# Copy this to .env.production after setting up your domain

# Database Configuration (Docker service name)
DB_HOST=database
DB_PORT=5432
DB_NAME=laundry_management
DB_USER=postgres
DB_PASSWORD=postgres

# Application URLs - UPDATE THESE WITH YOUR DOMAIN
FRONTEND_URL=https://laundry.inichepro.in
BACKEND_URL=https://api.laundry.inichepro.in
VITE_API_URL=https://api.laundry.inichepro.in/api

# CORS Configuration - UPDATE WITH YOUR DOMAIN
CORS_ORIGIN=https://laundry.inichepro.in,https://api.laundry.inichepro.in,https://mobile-api.laundry.inichepro.in

# Server Configuration
PORT=5000
NODE_ENV=production

# Security Configuration - CHANGE THESE IN PRODUCTION
SESSION_SECRET=your-super-secure-session-secret-change-this
SESSION_NAME=laundry_session
SESSION_MAX_AGE=86400000
BCRYPT_ROUNDS=12

# Rate Limiting (more restrictive for internet)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# HTTPS Configuration (Cloudflare handles SSL)
HTTPS_ENABLED=true
FORCE_HTTPS=true
TRUST_PROXY=true

# CORS Configuration
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,CF-Ray,CF-Connecting-IP

# Security Headers (enhanced for internet)
HELMET_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Logging Configuration (more detailed for production)
LOG_LEVEL=info
LOG_FORMAT=combined
ACCESS_LOG_ENABLED=true

# Performance Optimization
COMPRESSION_ENABLED=true
STATIC_CACHE_MAX_AGE=86400000

# Database Security
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_MAX_CONNECTIONS=20

# Cloudflare Tunnel Configuration
# Option 1: Use Tunnel Token (Recommended for Docker)
# Get this from Cloudflare Dashboard > Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=eyJhIjoiOWFlOTMyNjVhODM4NTVlNTE5N2IzNDRjNGM3ZDhhMTIiLCJ0IjoiZTJkZjFmZDctYTU5YS00ZTQwLTg1YTMtMzg0NmI5MGUyZGVhIiwicyI6Ik5tWTRPREJoTVdZdFpXRTRaUzAwTlRKbUxXSXdOall0WXpWak5tWTRaV1kzWlRaaiJ9

# Option 2: Use API Token (requires manual tunnel setup)
# CLOUDFLARE_API_TOKEN=327jGj0kZqdkAyKuEoJfQ0t_ARN7YlCMa9TFKsMV
# DOMAIN_NAME=laundry.inichepro.in
# TUNNEL_NAME=laundry-mgmt
API_SUBDOMAIN=api
MOBILE_SUBDOMAIN=mobile-api
CLOUDFLARED_LOG_LEVEL=info

# Cloudflare specific headers
CF_ZONE_ID=your-cloudflare-zone-id
CF_API_TOKEN=your-cloudflare-api-token
