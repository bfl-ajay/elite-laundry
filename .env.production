# Production Environment Configuration

# Database Configuration (Docker service name)
DB_HOST=database
DB_PORT=5432
DB_NAME=laundry_management
DB_USER=postgres
DB_PASSWORD=postgres

# Application URLs
FRONTEND_URL=https://elite.inichepro.in
BACKEND_URL=https://elite-api.inichepro.in
VITE_API_URL=https://elite-api.inichepro.in/api

# CORS Configuration
CORS_ORIGIN=http://localhost:8081,http://localhost:3000,http://localhost:8080,https://elite.inichepro.in,http://elite.inichepro.in

# Server Configuration
PORT=5000
NODE_ENV=production

# Security Configuration - CHANGE THESE IN PRODUCTION
SESSION_SECRET=your-super-secure-session-secret-change-this
SESSION_NAME=laundry_session
SESSION_MAX_AGE=86400000
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# HTTPS Configuration
HTTPS_ENABLED=false
FORCE_HTTPS=false
TRUST_PROXY=false

# CORS Configuration
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Security Headers
HELMET_ENABLED=true
CSP_ENABLED=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Logging Configuration (more detailed for production)
LOG_LEVEL=info
LOG_FORMAT=combined
ACCESS_LOG_ENABLED=true

# Performance Optimization
COMPRESSION_ENABLED=true
STATIC_CACHE_MAX_AGE=86400000

# Database Security
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_MAX_CONNECTIONS=20


